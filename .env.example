# Base de données (MySQL)
# Format: mysql+aiomysql://user:password@host:port/database
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/healthai_coach

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# (Optionnel) Clé applicative si tu ajoutes de l'auth plus tard
SECRET_KEY=change-me

# Sécurité minimale
# Clé requise pour toutes les routes /api/v1/admin/* (header: X-API-Key)
ADMIN_API_KEY=dev-admin-key

# CORS (liste séparée par des virgules). Exemple:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=

# Environment: development|production
ENV=development
