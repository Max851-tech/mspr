# MySQL (local ou Docker)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/healthai_coach

# FastAPI (port d’écoute du processus uvicorn — souvent 8000 dans le conteneur)
API_HOST=0.0.0.0
API_PORT=8000

# JWT : obligatoire en production ; en dev une valeur longue quelconque suffit (pas lié à l’inscription qui échoue “réseau”)
SECRET_KEY=remplace-par-une-chaine-longue-et-aleatoire

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Port vu par le navigateur / Vite (hôte). Avec le docker-compose du dépôt, l’API est sur 8001.
# En uvicorn local sans Docker sur le port 8000 : VITE_PUBLIC_API_PORT=8000
VITE_PUBLIC_API_PORT=8001

# Optionnel : URL complète du backend pour le proxy Vite (prioritaire sur VITE_PUBLIC_API_PORT)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# Admin API (routes /api/v1/admin/*)
# ADMIN_API_KEY=dev-admin-key
