# MySQL — XAMPP uniquement (localhost:3306, root souvent sans mot de passe).
# Avec Docker, l’API joint la même base via host.docker.internal:3306.
# Si ta base s’appelle `healthai_coaching` (dump), remplace juste le nom à la fin de l’URL.
DATABASE_URL=mysql+aiomysql://root@localhost:3306/healthai_coach

# FastAPI (port d’écoute du processus uvicorn — souvent 8000 dans le conteneur)
API_HOST=0.0.0.0
API_PORT=8000

# JWT : obligatoire en production ; en dev une valeur longue quelconque suffit (pas lié à l’inscription qui échoue “réseau”)
SECRET_KEY=remplace-par-une-chaine-longue-et-aleatoire

# Inclure 5174 si Vite bascule (5173 déjà pris).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Port du proxy Vite → port hôte de l’API avec docker-compose (8001). Uvicorn local seul : 8000.
VITE_PUBLIC_API_PORT=8001

# Optionnel : URL complète du backend pour le proxy Vite (prioritaire sur VITE_PUBLIC_API_PORT)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# Admin API (routes /api/v1/admin/*)
# ADMIN_API_KEY=dev-admin-key
